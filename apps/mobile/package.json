{
  "name": "@lifeplate/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/metro-runtime": "~56.0.15",
    "@expo/ui": "~56.0.18",
    "@expo/vector-icons": "^15.1.1",
    "@lifeplate/shared": "workspace:^",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.47.10",
    "expo": "~56.0.12",
    "expo-auth-session": "^56.0.14",
    "expo-blur": "^56.0.3",
    "expo-constants": "~56.0.18",
    "expo-file-system": "^56.0.8",
    "expo-font": "~56.0.7",
    "expo-haptics": "^56.0.3",
    "expo-image-manipulator": "^56.0.19",
    "expo-image-picker": "^56.0.18",
    "expo-linking": "~56.0.14",
    "expo-media-library": "~56.0.7",
    "expo-modules-core": "~56.0.17",
    "expo-print": "^56.0.4",
    "expo-router": "~56.2.11",
    "expo-screen-orientation": "^56.0.5",
    "expo-secure-store": "^56.0.4",
    "expo-sharing": "^56.0.18",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-web-browser": "~56.0.5",
    "expo-widgets": "~56.0.19",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-paper": "^5.15.3",
    "react-native-purchases": "^9.0.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@expo/config-plugins": "~56.0.8",
    "@types/react": "~19.2.2",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "eas-build-pre-install": "corepack enable",
    "eas-build-post-install": "cd ../.. && pnpm --filter @lifeplate/shared build",
    "dev": "pnpm --filter @lifeplate/shared build && expo start --port 8082",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @lifeplate/shared build && node --import tsx --test lib/__tests__/*.test.ts",
    "start": "pnpm --filter @lifeplate/shared build && expo start",
    "android": "pnpm --filter @lifeplate/shared build && expo run:android",
    "prebuild:ios": "pnpm --filter @lifeplate/shared build && expo prebuild --platform ios --clean",
    "ios": "pnpm --filter @lifeplate/shared build && expo prebuild --platform ios && expo run:ios",
    "ios:device": "pnpm --filter @lifeplate/shared build && expo prebuild --platform ios && expo run:ios --device --configuration Release",
    "web": "pnpm --filter @lifeplate/shared build && expo start --web"
  },
  "private": true
}
