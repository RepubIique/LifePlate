EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_API_URL=http://localhost:3001

# RevenueCat — leave disabled until App Store / Play products are ready
EXPO_PUBLIC_REVENUECAT_ENABLED=false
# RevenueCat → Project Settings → API keys → Public app-specific keys
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Must match REVENUECAT_ENTITLEMENT_ID on the API
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=plus
