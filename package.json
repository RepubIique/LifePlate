{
  "name": "lifeplate",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @lifeplate/api dev",
    "dev:mobile": "pnpm --filter @lifeplate/mobile dev",
    "ios:device": "pnpm --filter @lifeplate/mobile ios:device",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @lifeplate/api db:migrate",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @lifeplate/shared test",
    "build:api": "pnpm --filter @lifeplate/shared build && pnpm --filter @lifeplate/api build"
  },
  "dependencies": {
    "expo": "~56.0.0-preview.8",
    "react": "19.2.3",
    "react-native": "0.85.3"
  }
}
