{
  "name": "lifeplate",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @lifeplate/api dev",
    "dev:mobile": "pnpm --filter @lifeplate/mobile dev",
    "ios:device": "pnpm --filter @lifeplate/mobile ios:device",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @lifeplate/api db:migrate",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @lifeplate/shared test && pnpm --filter @lifeplate/api test && pnpm --filter @lifeplate/mobile test",
    "build:api": "pnpm --filter @lifeplate/shared build && pnpm --filter @lifeplate/api build"
  },
  "pnpm": {
    "patchedDependencies": {
      "@react-native/gradle-plugin@0.85.3": "patches/@react-native__gradle-plugin@0.85.3.patch"
    }
  }
}
